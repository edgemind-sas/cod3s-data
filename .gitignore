docs/_build/
site/

# Data files
*.csv
*.json
*.jsonl
!tests/fixtures/*.csv
!tests/fixtures/*.json
!tests/fixtures/*.jsonl
# The '*.json' rule above is aimed at sample data, but it also swallows every
# JSON config file in the tree. Frontend tooling config must stay versioned:
# without the lockfile, CI has no reproducible 'npm ci'.
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json

# Frontend
frontend/node_modules/
frontend/dist/
# cod3s_data/observatory/static/ is deliberately NOT ignored: the built UI ships
# inside the wheel, so it has to be versioned. CI rebuilds it and fails if the
# committed artifact no longer matches the sources.

# Logs
*.log

# OS
.DS_Store
Thumbs.db
