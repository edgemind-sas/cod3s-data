  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@mdi/font": "^7.4.0",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuetify": "^3.8.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
}
